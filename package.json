{
  "name": "rulecraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "workspaces": [
    "packages/simulation"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "typecheck": "tsc -p packages/simulation/tsconfig.json && tsc",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:pages": "playwright test --config playwright.pages.config.mjs",
    "simulate": "node tools/task-01-run.mjs",
    "simulate:law": "node tools/task-02-demo.mjs",
    "simulate:society": "node tools/task-03-run.mjs",
    "study:society": "node tools/task-03-study.mjs",
    "build": "npm run typecheck && vite build apps/web --outDir ../../dist --emptyOutDir",
    "build:pages": "npm run build -- --base=/rulecraft/ && node tools/check-pages-build.mjs",
    "preview": "vite preview apps/web --outDir ../../dist"
  },
  "dependencies": {
    "@rulecraft/simulation": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
