{
  "name": "rulecraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "workspaces": ["packages/simulation"],
  "scripts": {
    "dev": "vite apps/web",
    "typecheck": "tsc -p packages/simulation/tsconfig.json && tsc",
    "test": "vitest run",
    "simulate": "node tools/task-01-run.mjs",
    "simulate:law": "node tools/task-02-demo.mjs",
    "build": "npm run typecheck && vite build apps/web --outDir ../../dist --emptyOutDir",
    "preview": "vite preview apps/web --outDir ../../dist"
  },
  "dependencies": {
    "@rulecraft/simulation": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
